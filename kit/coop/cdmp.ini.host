; Crimson Desert Multiplayer - 1.0.0.3549 - HOST
; Generated by tools/porting/make_steam_kit.py from cdmp.3527-2inst-host.ini: edit only player_name and peer_steamid.

[general]
; Your name (the other player sees it)
player_name=Player
startup_delay_ms=0

[net]
enabled=1
; Through Steam, no ports to open. You must be Steam friends.
transport=steam
role=host
send_rate_hz=20

[steam]
; Guest: the host's SteamID64 (17 digits). Empty = the only Steam friend playing
; Crimson Desert right now. Host: empty = accepts any friend who is playing.
peer_steamid=
channel=67
recv_buffer_kb=16384
recv_buffer_messages=16384

[overlay]
enabled=1
self_marker=0

[sniffer]
enabled=1
; 1 = saves a network capture for debugging (about 25 MB a minute)
record=0

[coop]
enabled=0

[dev]
clone_hotkeys=0
combat_tests=0
minimap_cycle=0
aggro_test=0
enemy_relay=0
piece4_test=0
attack_probe=0

[session2]
; Ships (3663, 2026-11-14): the guest standing on the host's ship is drawn on the ship (without this the host sees a
; guest who stands still left behind in the water while the ship sails). A ship the guest sails would be followed
; here too (not tested).
; probe = measure only; 0 = off.
vehicle_follow=1
; The press-time interaction check (build 3549): a guest key; probe here logs the host's own presses.
interact_gate=0
interact_gate_errors=
; Shops (build 3549): the guest's buy/sell passes the shop-scene test (host: at its server; guest: in its UI).
store_gate=1
; Houses (3576, 2026-11-12, two copies): the guest gets the host's houses instead of its own and sees the host's
; whole house: walls, floors, roof, balcony, the door and the window shutters, and the host's changes in the
; construction mode right away (with the guest's housing_redraw=1 and housing_gimmick_guard=1). The host may use the
; construction mode with the guest there. 0 = the guest sees its own houses.
housing_share=1
; Which of the host's housing messages the guest's copy takes as its own. 35245,2733 = the house's structure (walls,
; floors, roof). 0 = no walls (only the host's furniture and doors, floating). 1 = all of them: the guest's game
; CRASHED near the house or when the host opened the construction mode.
housing_share_rekey=35245,2733
; 0 = the guest's copy of the house keeps everything (the door and window openings, the roof, the door, the shutters).
; It needs the guest's housing_gimmick_guard=1 (without it the guest crashed when the host opened the construction
; mode). waiting = leaves out the objects the host's game spawns (no door, the doorway walled up); all = also the roof.
housing_share_drop_gimmicks=0
; 1 = the host's changes in the construction mode reach the guest (live with the guest's housing_redraw=1, and on its
; next join). 0 = the guest keeps the house as it was when the host joined.
housing_share_edits=1
; 0 (default): only the host's game spawns the house's furniture (the guest's own spawn crashed it).
housing_share_guest_spawn=0
; 1 = the guest's game gets the host's level states when it joins, so the house plot looks developed (level
; grass) as on the host. 0 = the guest saw the plot before the house: a pond beside the porch.
housing_share_level_states=1
enabled=1
guest=0
guest_mode=observe
probe=1

; Required native host path.
create_session=1
accept_tunnel=1
share_field=1
relay_fix=1
clock_gate=1
identity_fix=1
; Capture local faults in this host without enabling guest gameplay hooks.
guest_crash_dump=1

; The real save tree remains untouched. The launcher also makes a checked backup.
save_guard=redirect
host_save=probe
block_save_trocs=0
guest_own_save=1

; New actors reach the other player only once they have an action: without it the
; client's copy has an empty action layer, and native code crashes reading it.
child_hold=1
child_settle_ms=4000
observer_hold=1
observer_hold_family=1
observer_load_defer=1
observer_hold_acks=1
character_hold=1
; The host's world clock for the guest, behind each of its loads.
user2_clock_push=1

finder_log=0
mirror_host=0
identity_probe=0
companion_probe=0
reconnect=1
rejoin=1
tunnel_compress=1
c4_safe_reads=0

; Explicitly neutralize parser defaults that can otherwise enable behavior.
user2_loading_owner_alias=0
ride_dismount=native
observer_seq_copy_2322=1
guest_x_camera_veto=0
guest_local_after_remote=allow

; All 2976-only gameplay/diagnostic hooks stay off for the first login.
load_diag=0
s1_diag=0
observer_stage_sync=0
; Required for entering the host's field: the native owner-only path sends
; no preload-complete message to an observer. Verified synchronously on 3527.
observer_milestone=1
observer_milestone_send=1
observer_scene_copy=1
notify_thread_rule=0
ui_pause_block=1
seq_marker_guard=1
change_pivot_guard=1
focus_follow=1
field_leave_guard=1
manager_probe=1
s1_scene_diag=0
guest_scene_diag=0
rank_permit=1
quest_per_user=1
quest_policy=probe
kill_loot_per_user=1
user2_fast_travel=1
user2_revive_manager=1
remote_climb=1
wallup_send=1
dismount_probe=0
divergence_probe=0
freeze_watchdog=0
remote_interp=1
remote_interp_owned_cap_ms=900
horse_follow=1
attach_follow=probe
ride_filter=1
mount_relink=1
ride_hold_pos=probe
mount_seat=1
mount_sync=1
child_reannounce=0
combat_follow=1
combat_follow_v2=1
remote_interp_combat=0
user2_world_anchor=0
horse_follow_reverse=1
remote_interp_pair=1
remote_interp_players=1
observer_seq_copy=1
observer_sched_copy=0
owner_fanout=0
shop_probe=0
funcnpc_twin=0
user2_stages=0
user2_timer_route=0
user2_shop_route=0
shop_trade_probe=0
user2_shop_trade_route=0
observer_hold_scene_order=0
user2_shop_trade_list=0
shop_interaction_own_delete=0
user2_npc_control=0
npc_activation=0
npc_family_control=0
npc_family_vehicles=0
enemy_damage_probe=0
door_trace=0
scene_level_share=1
user2_road_control=0
user2_road_carts=0
npc_action_evidence=0
npc_containment_guard=0
npc_degradation=0
publication_gate=0
guest_remote_update_guard=0
user2_drain_at_host_prepare=0
user2_fast_rearm=0
schedule_load_selfcheck=0
seq_actor_restore=0
block_guest_weather=1
clock_probe=0
weather_sync=1
catch_seq=1
remote_rope=0
rope_probe=0
tree_bend=0
docked_gimmicks=probe
docked_gimmicks_other=probe
gimmick_event_dedup=0

